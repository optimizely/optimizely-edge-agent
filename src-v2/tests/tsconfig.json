{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "outDir": "../../dist/tests",
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "~/*": ["../*"]
    }
  },
  "include": [
    "./**/*.ts",
    "../**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
} 
# Optimizely Edge Agent Testing - Environment Variables
# Copy this file to .env and fill in the values

# Edge Agent URL - URL of the Edge Agent deployment
# Use http://localhost:8787 for local Wrangler dev testing
EDGE_AGENT_URL=http://localhost:8787

# SDK Key - Your Optimizely SDK key for the project
SDK_KEY=your-sdk-key-here

# Feature Keys - Comma-separated list of feature keys to test
# These should be feature flags that exist in your Optimizely project
FEATURE_KEYS=feature1,feature2,feature3

# Experiment Keys - Comma-separated list of experiment keys to test
# These should be experiments that exist in your Optimizely project
EXPERIMENT_KEYS=experiment1,experiment2

# Debug Mode - Set to true to enable debug logging
DEBUG=false 
{
  "name": "optly-edge-agent-fastly",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "18.x"
  },
  "scripts": {
    "build": "tsc -p tsconfig.fastly.json",
    "build:fastly": "fastly compute build",
    "deploy": "npm run build && fastly compute deploy",
    "dev": "fastly compute serve --watch",
    "format": "prettier --loglevel warn --write \"{src,src-v2}/**/*.{jsx,js,ts}\"",
    "test": "vitest",
    "test:integration": "ts-node src-v2/tests/run-integration-tests.ts"
  },
  "dependencies": {
    "@optimizely/optimizely-sdk": "^5.3.4",
    "@fastly/js-compute": "^3.0.0",
    "node-fetch": "^2.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.12.11",
    "@types/node-fetch": "^2.6.2",
    "prettier": "^3.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
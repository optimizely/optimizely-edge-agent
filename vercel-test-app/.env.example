# Optimizely Configuration
OPTIMIZELY_SDK_KEY=your-optimizely-sdk-key
NEXT_PUBLIC_OPTIMIZELY_SDK_KEY=your-optimizely-sdk-key

# Edge Agent Configuration
OPTIMIZELY_ENABLE_EDGE_MODE=true
OPTIMIZELY_ENABLE_AGENT_MODE=true
OPTIMIZELY_LOG_LEVEL=info
OPTIMIZELY_CACHE_TTL=300
OPTIMIZELY_AUTO_DATAFILE_UPDATES=true

# Admin Configuration (optional)
OPTIMIZELY_ADMIN_TOKEN=your-admin-token
OPTIMIZELY_ENABLE_DEBUG_HEADERS=false

# Metrics Configuration (optional)
OPTIMIZELY_METRICS_ENABLED=true
METRICS_PROVIDER=datadog

# DataDog Configuration (if using DataDog)
DD_API_KEY=your-datadog-api-key
DD_SITE=datadoghq.com
DD_ENV=development
DD_SERVICE=optimizely-edge-agent-test

# New Relic Configuration (if using New Relic)
# NEW_RELIC_LICENSE_KEY=your-license-key
# NEW_RELIC_REGION=US
# NEW_RELIC_APP_NAME=optimizely-edge-agent-test

# Prometheus Configuration (if using Prometheus)
# PROMETHEUS_PUSH_GATEWAY_URL=http://localhost:9091
# PROMETHEUS_JOB_NAME=edge_agent_test